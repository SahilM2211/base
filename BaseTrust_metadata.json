					"details": "3. Beneficiary (Child) claims their unlocked funds when they come of age."
				},
				"createTrust(address,address,uint256[],uint256[])": {
					"details": "1. Grandparent creates the Trust and defines the Time-Locks."
				},
				"emergencyWithdraw(uint256,address,uint256,string)": {
					"details": "4. Guardian (Parent) can override the time-locks ONLY for emergencies (e.g., Hospital Bills, Tuition). Bypasses the child's wallet and pays the institution directly. Leaves a permanent audit trail."
				},
				"fundTrust(uint256)": {
					"details": "2. Anyone (Aunts, Uncles, Parents) can deposit ETH into the child's trust for birthdays/holidays."
				},
				"getAvailableToClaim(uint256)": {
					"details": "Calculate how much ETH the beneficiary is legally allowed to withdraw right now. This math elegantly handles new deposits arriving *after* a milestone has passed."
				}
