		"devdoc": {
			"details": "Enterprise-grade Decentralized Letter of Credit (Trade Finance). Secures international imports/exports by locking buyer funds in escrow, releasing them only when a designated Inspector/Freight Forwarder verifies delivery.",
			"kind": "dev",
			"methods": {
				"approveGoods(uint256)": {
					"details": "4a. Happy Path: Inspector verifies goods at destination port. Funds auto-release to seller."
				},
				"draftTrade(address,address,string,uint256,uint256)": {
					"details": "1. Buyer (Importer) drafts the commercial invoice / trade agreement."
				},
				"fundTrade(uint256)": {
					"details": "2. Buyer locks the funds in the contract (The \"Letter of Credit\")."
				},
				"markShipped(uint256)": {
					"details": "3. Seller (Exporter) marks the goods as shipped after verifying funds are locked."
				},
				"recallExpiredFunds(uint256)": {
					"details": "6. Time-lock protection: If goods never arrive by expiry date, Buyer can recall funds."
				},
				"rejectGoods(uint256,string)": {
					"details": "4b. Sad Path: Inspector rejects goods (damaged/counterfeit). Dispute begins."
				},
				"resolveDispute(uint256,uint256,uint256)": {
					"details": "5. Inspector resolves dispute by splitting funds (e.g., 50% refund, 50% pay for partial damage)."
				}
			},
			"title": "BaseTrade Protocol",
			"version": 1
		},
