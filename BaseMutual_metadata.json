				},
				"processClaim(uint256)": {
					"details": "5. Process the claim after sufficient voting. For security, requires > 50% of ALL eligible members to vote YES for approval."
				},
				"submitClaim(uint256,string)": {
					"details": "3. A member suffers a loss and submits a claim."
				},
				"voteOnClaim(uint256,bool)": {
